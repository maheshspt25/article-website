# Next.js Base Site URL for Canonical URLs, Sitemaps & Structured Data
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Database URL for Prisma (SQLite for dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Optional Analytics Tracking IDs
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
